{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "First Contact",
  "version": "0.1.0",
  "identifier": "co.lindroos.first-contact",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "First Contact",
        "width": 520,
        "height": 460,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "liquidGlassRegular",
            "underWindowBackground"
          ]
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}